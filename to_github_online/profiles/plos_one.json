{
  "id": "plos_one",
  "journal": "PLOS ONE",
  "publisher": "PLOS",
  "template_family": "generic",
  "guide_url": "https://journals.plos.org/plosone/s/submission-guidelines",
  "verified": false,
  "notes": "Figures must be uploaded as TIFF or EPS; the manuscript file itself carries no embedded final artwork. Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "structure": {
    "abstract_max_words": 300,
    "abstract_paragraphs_max": 1,
    "title_max_chars": 250,
    "required_sections": [
      "abstract",
      "introduction",
      "methods",
      "results",
      "discussion",
      "references"
    ],
    "section_order": [
      "abstract",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 90.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 190.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 600,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif",
      "png",
      "jpg",
      "jpeg"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "plos.csl",
    "doi_required": false,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "article",
    "class_options": [
      "11pt"
    ],
    "bibliography_style": "unsrt",
    "template_family": "generic"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 25,
      "right": 25
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://journals.plos.org/plosone/s/submission-guidelines"
  }
}
