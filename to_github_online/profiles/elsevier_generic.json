{
  "id": "elsevier_generic",
  "journal": "Generic Elsevier journal (elsarticle)",
  "publisher": "Elsevier",
  "template_family": "elsarticle",
  "homepage": "https://www.elsevier.com/",
  "guide_url": "https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-sizing",
  "verified": true,
  "notes": "Baseline for all elsarticle journals. Abstract and keyword limits vary per journal and MUST be overridden in a journal-specific profile; the values here are the common defaults. Elsevier accepts format-free initial submissions - strict formatting binds at revision.",
  "structure": {
    "abstract_max_words": 250,
    "abstract_paragraphs_max": 1,
    "keywords_min": 3,
    "keywords_max": 6,
    "highlights_required": true,
    "highlights_min": 3,
    "highlights_max": 5,
    "highlights_max_chars": 85,
    "required_sections": [
      "abstract",
      "keywords",
      "introduction",
      "conclusion",
      "references"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 90.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 190.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "min_px_single_column": 1063,
    "min_px_double_column": 2244,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "elsevier-with-titles.csl",
    "doi_required": false,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "elsarticle",
    "class_options": [
      "review",
      "3p",
      "times"
    ],
    "bibliography_style": "elsarticle-num",
    "template_family": "elsarticle"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "figures": "https://www.elsevier.com/about/policies-and-standards/author/artwork-and-media-instructions/artwork-sizing",
    "structure.highlights": "https://www.elsevier.com/researcher/author/tools-and-resources/highlights"
  },
  "scope_keywords": [
    "energy",
    "renewable",
    "power",
    "system",
    "optimisation",
    "optimization",
    "efficiency",
    "modelling",
    "modeling",
    "control",
    "sustainability",
    "electric",
    "solar",
    "wind"
  ]
}
