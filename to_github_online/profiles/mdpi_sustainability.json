{
  "id": "mdpi_sustainability",
  "journal": "Sustainability",
  "publisher": "MDPI",
  "template_family": "mdpi",
  "guide_url": "https://www.mdpi.com/journal/sustainability/instructions",
  "verified": false,
  "notes": "Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "scope_keywords": [
    "sustainability",
    "renewable energy",
    "environment",
    "sustainable development"
  ],
  "structure": {
    "abstract_max_words": 200,
    "abstract_paragraphs_max": 1,
    "keywords_min": 3,
    "keywords_max": 10,
    "required_sections": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "references"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 85.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 170.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "multidisciplinary-digital-publishing-institute.csl",
    "doi_required": true,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "Definitions/mdpi",
    "bibliography_style": "mdpi",
    "template_family": "mdpi"
  },
  "docx": {
    "body_font": "Palatino Linotype",
    "body_size_pt": 10.0,
    "line_spacing": 1.0,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 20,
      "right": 20
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://www.mdpi.com/journal/sustainability/instructions"
  }
}
