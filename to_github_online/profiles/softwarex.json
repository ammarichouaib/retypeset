{
  "id": "softwarex",
  "journal": "SoftwareX",
  "publisher": "Elsevier",
  "template_family": "elsarticle",
  "homepage": "https://www.sciencedirect.com/journal/softwarex",
  "guide_url": "https://www.sciencedirect.com/journal/softwarex/publish/guide-for-authors",
  "verified": false,
  "notes": "Original Software Publication. Fixed section skeleton: 1 Motivation and significance, 2 Software description (2.1 architecture, 2.2 functionalities), 3 Illustrative examples, 4 Impact, 5 Conclusions. A completed Code metadata table and a public code repository with a recognised licence are mandatory; the manuscript is capped at about six printed pages, so `manuscript_max_words` is an approximation of that page cap, not a stated word limit. Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "scope_keywords": [
    "research software",
    "scientific software",
    "open source",
    "code",
    "reproducibility",
    "software architecture",
    "software impact"
  ],
  "structure": {
    "abstract_max_words": 500,
    "abstract_paragraphs_max": 1,
    "keywords_min": 3,
    "keywords_max": 6,
    "highlights_required": false,
    "highlights_min": 3,
    "highlights_max": 5,
    "highlights_max_chars": 85,
    "required_sections": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "conclusion",
      "references"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "references"
    ],
    "manuscript_max_words": 3000
  },
  "figures": {
    "single_column_mm": 90.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 190.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "elsevier-with-titles.csl",
    "doi_required": false,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "elsarticle",
    "class_options": [
      "review",
      "3p",
      "times"
    ],
    "bibliography_style": "elsarticle-num",
    "template_family": "elsarticle"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 1.5,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 25,
      "right": 25
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://www.sciencedirect.com/journal/softwarex/publish/guide-for-authors"
  }
}
