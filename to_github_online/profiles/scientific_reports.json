{
  "id": "scientific_reports",
  "journal": "Scientific Reports",
  "publisher": "Springer Nature",
  "template_family": "sn-jnl",
  "guide_url": "https://www.nature.com/srep/author-instructions",
  "verified": false,
  "notes": "Results precede Methods in the printed order and the abstract carries no references or citations. Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "scope_keywords": [
    "natural sciences",
    "engineering",
    "multidisciplinary"
  ],
  "structure": {
    "abstract_max_words": 200,
    "abstract_paragraphs_max": 1,
    "keywords_min": 0,
    "keywords_max": 0,
    "required_sections": [
      "abstract",
      "introduction",
      "methods",
      "results",
      "discussion",
      "references"
    ],
    "section_order": [
      "abstract",
      "introduction",
      "results",
      "discussion",
      "methods",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 90.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 190.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg",
      "ai"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "nature.csl",
    "in_text_format": "n (superscript)"
  },
  "latex": {
    "document_class": "sn-jnl",
    "class_options": [
      "sn-mathphys-num"
    ],
    "bibliography_style": "sn-mathphys-num",
    "template_family": "sn-jnl"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 25,
      "right": 25
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://www.nature.com/srep/author-instructions"
  }
}
