# Copy to secrets.toml and fill in. secrets.toml is gitignored - never commit keys,
# and never paste this file into a chat or an issue. If you have, revoke and reissue.
#
#   Groq        https://console.groq.com/keys        key starts gsk_
#   Gemini      https://aistudio.google.com/apikey   key starts AIza
#   OpenRouter  https://openrouter.ai/keys           key starts sk-or-
#   DeepSeek    https://platform.deepseek.com        key starts sk-
#   Moonshot    https://platform.moonshot.ai         key starts sk-
#
# Ollama needs no key: `ollama serve` then `ollama pull llama3.1:8b`.
# Ollama only works when retypeset runs on the same machine - on a hosted deployment
# "localhost" is the server, not your computer.

GROQ_API_KEY = ""
GEMINI_API_KEY = ""
OPENROUTER_API_KEY = ""
DEEPSEEK_API_KEY = ""
KIMI_API_KEY = ""
