{
  "id": "joss",
  "journal": "Journal of Open Source Software",
  "publisher": "Open Journals",
  "template_family": "generic",
  "guide_url": "https://joss.readthedocs.io/en/latest/submitting.html",
  "verified": false,
  "notes": "Markdown + paper.bib only: JOSS builds the PDF itself, so the DOCX and LaTeX routes here are for drafting, not submission. Expected length is roughly 250-1000 words. Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "scope_keywords": [
    "research software",
    "open source",
    "software"
  ],
  "structure": {
    "manuscript_max_words": 1000,
    "required_sections": [
      "introduction",
      "references"
    ],
    "section_order": [
      "introduction",
      "methods",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 90.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 190.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "png",
      "jpg",
      "jpeg",
      "pdf",
      "svg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "author-year",
    "csl_file": "apa.csl",
    "doi_required": true,
    "in_text_format": "[@key]"
  },
  "latex": {
    "document_class": "article",
    "class_options": [
      "11pt"
    ],
    "bibliography_style": "unsrt",
    "template_family": "generic"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 25,
      "right": 25
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://joss.readthedocs.io/en/latest/submitting.html"
  }
}
