{
  "id": "mdpi",
  "journal": "Generic MDPI journal (Energies, Applied Sciences, ...)",
  "publisher": "MDPI",
  "template_family": "mdpi",
  "homepage": "https://www.mdpi.com/",
  "guide_url": "https://www.mdpi.com/authors/layout",
  "verified": true,
  "notes": "Abstract is capped at 200 words in a single paragraph and must contain no citations, equations, figures or tables. MDPI requires several back-matter declarations that most other publishers treat as optional.",
  "structure": {
    "abstract_max_words": 200,
    "abstract_paragraphs_max": 1,
    "abstract_structured": true,
    "keywords_min": 3,
    "keywords_max": 10,
    "highlights_required": false,
    "required_sections": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "conclusion",
      "references",
      "author_contributions",
      "funding",
      "conflict_of_interest",
      "data_availability"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "author_contributions",
      "funding",
      "data_availability",
      "acknowledgements",
      "conflict_of_interest",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 85.0,
    "one_half_column_mm": null,
    "double_column_mm": 170.0,
    "dpi_halftone": 300,
    "dpi_combination": 600,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "multidisciplinary-digital-publishing-institute.csl",
    "doi_required": true,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "Definitions/mdpi",
    "class_options": [
      "journal=energies",
      "article"
    ],
    "bibliography_style": "mdpi",
    "template_family": "mdpi"
  },
  "docx": {
    "body_font": "Palatino Linotype",
    "body_size_pt": 10.0,
    "line_spacing": 1.0,
    "columns": 1,
    "page_size": "a4",
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "structure.abstract_max_words": "https://www.mdpi.com/authors/layout"
  },
  "scope_keywords": [
    "energy",
    "sustainability",
    "renewable",
    "solar",
    "wind",
    "hydrogen",
    "storage",
    "efficiency",
    "optimisation",
    "optimization",
    "smart grid",
    "electric vehicle"
  ]
}
