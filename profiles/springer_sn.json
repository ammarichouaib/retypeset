{
  "id": "springer_sn",
  "journal": "Generic Springer Nature journal (sn-jnl)",
  "publisher": "Springer Nature",
  "template_family": "sn-jnl",
  "homepage": "https://www.springernature.com/",
  "guide_url": "https://www.springernature.com/gp/authors/campaigns/latex-author-support",
  "verified": false,
  "notes": "Springer accepts format-free initial submission. Abstract and keyword limits vary by journal; verify against the specific journal's submission guidelines before relying on the numbers here.",
  "structure": {
    "abstract_max_words": 250,
    "abstract_min_words": 150,
    "abstract_paragraphs_max": 1,
    "keywords_min": 4,
    "keywords_max": 6,
    "highlights_required": false,
    "required_sections": [
      "abstract",
      "keywords",
      "introduction",
      "conclusion",
      "references"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "funding",
      "conflict_of_interest",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 84.0,
    "one_half_column_mm": 129.0,
    "double_column_mm": 174.0,
    "dpi_halftone": 300,
    "dpi_combination": 600,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "springer-basic-brackets.csl",
    "doi_required": true,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "sn-jnl",
    "class_options": [
      "sn-mathphys-num"
    ],
    "bibliography_style": "sn-mathphys-num",
    "template_family": "sn-jnl"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {},
  "scope_keywords": [
    "engineering",
    "energy",
    "electrical",
    "modelling",
    "modeling",
    "optimisation",
    "optimization",
    "control",
    "simulation",
    "materials",
    "system"
  ]
}
