{
  "id": "acs_generic",
  "journal": "ACS (generic journal)",
  "publisher": "American Chemical Society",
  "template_family": "generic",
  "guide_url": "https://pubs.acs.org/page/4authors/index.html",
  "verified": false,
  "notes": "Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "structure": {
    "abstract_max_words": 250,
    "keywords_min": 3,
    "keywords_max": 6,
    "required_sections": [
      "abstract",
      "introduction",
      "methods",
      "results",
      "conclusion",
      "references"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 82.6,
    "one_half_column_mm": 140.0,
    "double_column_mm": 177.8,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric-superscript",
    "csl_file": "american-chemical-society.csl",
    "in_text_format": "n (superscript)"
  },
  "latex": {
    "document_class": "article",
    "class_options": [
      "11pt"
    ],
    "bibliography_style": "unsrt",
    "template_family": "generic"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 25,
      "right": 25
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://pubs.acs.org/page/4authors/index.html"
  }
}
