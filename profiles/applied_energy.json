{
  "id": "applied_energy",
  "journal": "Applied Energy",
  "publisher": "Elsevier",
  "template_family": "elsarticle",
  "guide_url": "https://www.sciencedirect.com/journal/applied-energy/publish/guide-for-authors",
  "verified": false,
  "notes": "Limits transcribed from the publisher's author guide but not re-checked against the live page in this build, so `verified` stays false and every rule reports as a warning. Confirm at `guide_url` and flip `verified` to true once you have.",
  "scope_keywords": [
    "energy conversion",
    "energy systems",
    "renewable energy",
    "energy policy",
    "thermal systems",
    "energy storage",
    "power generation"
  ],
  "structure": {
    "abstract_max_words": 250,
    "abstract_paragraphs_max": 1,
    "keywords_min": 3,
    "keywords_max": 6,
    "highlights_required": true,
    "highlights_min": 3,
    "highlights_max": 5,
    "highlights_max_chars": 85,
    "required_sections": [
      "abstract",
      "keywords",
      "introduction",
      "conclusion",
      "references"
    ],
    "section_order": [
      "abstract",
      "keywords",
      "introduction",
      "methods",
      "results",
      "discussion",
      "conclusion",
      "acknowledgements",
      "references"
    ]
  },
  "figures": {
    "single_column_mm": 90.0,
    "one_half_column_mm": 140.0,
    "double_column_mm": 190.0,
    "dpi_halftone": 300,
    "dpi_combination": 500,
    "dpi_line_art": 1000,
    "accepted_formats": [
      "tif",
      "tiff",
      "eps",
      "pdf",
      "png",
      "jpg",
      "jpeg"
    ],
    "rejected_formats": [
      "emf",
      "wmf",
      "bmp",
      "gif"
    ],
    "caption_position": "below",
    "table_caption_position": "above"
  },
  "references": {
    "style": "numeric",
    "csl_file": "elsevier-with-titles.csl",
    "doi_required": false,
    "in_text_format": "[n]"
  },
  "latex": {
    "document_class": "elsarticle",
    "class_options": [
      "review",
      "3p",
      "times"
    ],
    "bibliography_style": "elsarticle-num",
    "template_family": "elsarticle"
  },
  "docx": {
    "body_font": "Times New Roman",
    "body_size_pt": 12.0,
    "line_spacing": 2.0,
    "columns": 1,
    "page_size": "a4",
    "margins_mm": {
      "top": 25,
      "bottom": 25,
      "left": 25,
      "right": 25
    },
    "line_numbers": true,
    "heading_numbering": "arabic"
  },
  "sources": {
    "all": "https://www.sciencedirect.com/journal/applied-energy/publish/guide-for-authors"
  }
}
